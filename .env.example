# ============================================================
# 复制为 .env 后填写。.env 不进 Git（见 .gitignore）。
# 原则：密钥只存在于环境变量，代码里不出现。
# ============================================================

ENVIRONMENT=dev

# --- 数据库 / 队列 ---
# 与本机 docker-compose.yml 的凭据对应（仅供本地 dev）
DATABASE_URL=postgresql+psycopg://logagent:logagent_dev_pw@127.0.0.1:5432/logagent
REDIS_URL=redis://127.0.0.1:6379/0

# --- 会话密钥 ---
SECRET_KEY=
ALLOW_REGISTRATION=false
COOKIE_SECURE=false
DEFAULT_DOMAIN_ID=computer_monitoring
UPLOAD_QUEUE=uploads
UPLOAD_QUEUE_TIMEOUT_SECONDS=1800
WORKER_TASK_TIMEOUT_SECONDS=600
WORKER_STARTUP_TIMEOUT_SECONDS=60
WORKER_PROBE_INTERVAL_SECONDS=30
WORKER_PROBE_TIMEOUT_SECONDS=20

# --- 模型等级 → 具体型号的映射 ---
# 业务代码只认 L1 / L2 / L3，型号只在这里出现（红线 2）。
# 阶段 06 之前必须填入真实型号与端点。
MODEL_L1=deepseek-flash
MODEL_L2=deepseek-flash
MODEL_L3=deepseek-flash
MODEL_PROVIDER_BASE_URL=https://api.deepseek.com
MODEL_PROVIDER_API_KEY=

# --- 推理档位（阶段 06 Router 用）---
# 合法值只有 off / low / high / max。
# off = 关闭思考（非思考模式）；low/high/max = 开启思考并指定强度。
# 注意：medium 不是合法值，官方与 DSH 适配器均不接受。
MODEL_L1_REASONING=off
MODEL_L2_REASONING=low
MODEL_L3_REASONING=high

# --- 成本单价（[计划补充项] 原文只说「自行填入配置」，未给配置项）---
# 单位：元 / 每 1M token。以所用模型官方现价为准，随模型迭代更新。
# 下表为 deepseek-flash「闲时价」，高峰时段按 MODEL_PEAK_PRICE_MULTIPLIER 翻倍。
MODEL_L1_PRICE_INPUT_PER_1M=1
MODEL_L1_PRICE_OUTPUT_PER_1M=4
MODEL_L2_PRICE_INPUT_PER_1M=1
MODEL_L2_PRICE_OUTPUT_PER_1M=4
MODEL_L3_PRICE_INPUT_PER_1M=1
MODEL_L3_PRICE_OUTPUT_PER_1M=4
# 缓存命中价与未命中价相差约 50 倍，阶段 07 成本控制必须分开计费
MODEL_CACHE_HIT_INPUT_PRICE_PER_1M=0.02
# 高峰时段倍数：上面的单价按「闲时价」填，高峰时段整体乘这个倍数。
# 高峰窗口 = 工作日 9:00–12:00、14:00–18:00（按 DEFAULT_TIMEZONE 的本地时间）。
# 填 1 表示不做峰谷调整。**注意不要漏**：漏了会让账单偏低，预算是"钱够不够"的闸门。
MODEL_PEAK_PRICE_MULTIPLIER=2

# --- 运行时数据目录（知识库 confirmed/staging 等）---
DATA_DIR=./data

# --- 预算 ---
# 货币单位统一为人民币元，与上面单价保持一致
# 两项都在"创建 Run"时做 Pre-check：
#   MONTHLY_BUDGET        本月（按 DEFAULT_TIMEZONE 的自然月）累计花费的上限；0 = 不设上限
#   DEFAULT_RUN_MAX_COST  单次 Run 的上限；0 = 这个 Run 一分钱都不许花
# 另外 projects.budget_total 是"每个项目"的上限（0 = 不设上限），三者取最紧的那个。
MONTHLY_BUDGET=10
DEFAULT_RUN_MAX_COST=0.30

# --- 时间 / 日志 ---
# 时间戳缺时区时按此解析，再转 UTC 存储
DEFAULT_TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO

# --- 可靠性 ---
# 僵尸 Run 的周期扫描间隔（秒）：beat 每隔这么久扫一次"心跳超时但仍停在 running"的 Run。
# 心跳超时是 300s（app/analysis/heartbeat.py），扫描必须比它勤得多，
# 否则"回收"最坏要等两倍超时才发现。改小更灵敏，改大更省。
ZOMBIE_REAP_INTERVAL_SECONDS=60
